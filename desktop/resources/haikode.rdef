resource app_signature "application/x-vnd.haikode";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "haikode",
	long_info = "haikode - native Haiku AI chat and coding agent"
};

