#!/bin/sh
# Resolve Python explicitly: stock Haiku may only provide python3.10.
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for candidate in python3 python3.13 python3.12 python3.11 python3.10; do
	if command -v "$candidate" >/dev/null 2>&1; then
		exec "$candidate" "$SCRIPT_DIR/project_context.py" "$@"
	fi
done

echo "project-preflight: Python 3.10 or newer is required" >&2
exit 127
